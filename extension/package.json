{
  "name": "agent-tour",
  "displayName": "Agent Tour",
  "description": "Guided, spotlighted code tours of changes written by coding agents.",
  "version": "0.0.1",
  "publisher": "trivium",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces tours never start automatically, start links are refused, and workspace settings cannot turn on auto-start.",
      "restrictedConfigurations": [
        "agentTour.autoStart"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "agentTour.start",
        "title": "Start Tour...",
        "category": "Agent Tour",
        "icon": "$(play)"
      },
      {
        "command": "agentTour.reload",
        "title": "Reload Tours",
        "category": "Agent Tour",
        "icon": "$(refresh)"
      },
      {
        "command": "agentTour.next",
        "title": "Next Step",
        "category": "Agent Tour",
        "enablement": "agentTour.active",
        "icon": "$(chevron-right)"
      },
      {
        "command": "agentTour.previous",
        "title": "Previous Step",
        "category": "Agent Tour",
        "enablement": "agentTour.active",
        "icon": "$(chevron-left)"
      },
      {
        "command": "agentTour.showCard",
        "title": "Show Step Card",
        "category": "Agent Tour",
        "enablement": "agentTour.active"
      },
      {
        "command": "agentTour.stop",
        "title": "Stop Tour",
        "category": "Agent Tour",
        "enablement": "agentTour.active",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentTour.goto",
        "title": "Go to Step",
        "category": "Agent Tour"
      }
    ],
    "keybindings": [
      {
        "command": "agentTour.next",
        "key": "alt+]",
        "when": "agentTour.active && !inlineSuggestionVisible"
      },
      {
        "command": "agentTour.previous",
        "key": "alt+[",
        "when": "agentTour.active && !inlineSuggestionVisible"
      },
      {
        "command": "agentTour.showCard",
        "key": "alt+h",
        "when": "agentTour.active"
      },
      {
        "command": "agentTour.stop",
        "key": "escape",
        "when": "agentTour.active && editorTextFocus && !editorHoverVisible && !suggestWidgetVisible && !findWidgetVisible && !parameterHintsVisible && !inSnippetMode && !editorHasSelection && !editorHasMultipleSelections && !notificationToastsVisible"
      }
    ],
    "configuration": {
      "title": "Agent Tour",
      "properties": {
        "agentTour.autoStart": {
          "type": "string",
          "enum": [
            "off",
            "prompt",
            "on"
          ],
          "default": "prompt",
          "description": "Whether a newly published tour starts automatically."
        },
        "agentTour.dimOpacity": {
          "type": "number",
          "default": 0.35,
          "minimum": 0.05,
          "maximum": 1,
          "description": "Opacity of code outside the current step."
        },
        "agentTour.dimMode": {
          "type": "string",
          "enum": [
            "opacity",
            "wash",
            "off"
          ],
          "default": "opacity",
          "description": "How code outside the current step is dimmed. 'opacity' relies on undocumented decoration CSS; 'wash' is the background-tint fallback."
        },
        "agentTour.cardStyle": {
          "type": "string",
          "enum": [
            "inline",
            "hover"
          ],
          "enumDescriptions": [
            "A card above the step that stays open until you move on.",
            "A hover card at the step; closes when you click elsewhere (Alt+H reopens it)."
          ],
          "default": "inline",
          "description": "How each step’s explanation is shown."
        }
      }
    },
    "colors": [
      {
        "id": "agentTour.changeBackground",
        "description": "Background of a 'change' step.",
        "defaults": {
          "dark": "#2ea04326",
          "light": "#2ea0431f",
          "highContrast": "#2ea04340",
          "highContrastLight": "#2ea04340"
        }
      },
      {
        "id": "agentTour.changeBorder",
        "description": "Left border and badge of a change step.",
        "defaults": {
          "dark": "#3fb950",
          "light": "#1a7f37",
          "highContrast": "#3fb950",
          "highContrastLight": "#1a7f37"
        }
      },
      {
        "id": "agentTour.contextBackground",
        "description": "Background of a 'context' step.",
        "defaults": {
          "dark": "#388bfd26",
          "light": "#0969da1a",
          "highContrast": "#388bfd40",
          "highContrastLight": "#0969da40"
        }
      },
      {
        "id": "agentTour.contextBorder",
        "description": "Left border and badge of a context step.",
        "defaults": {
          "dark": "#58a6ff",
          "light": "#0969da",
          "highContrast": "#58a6ff",
          "highContrastLight": "#0969da"
        }
      },
      {
        "id": "agentTour.riskBackground",
        "description": "Background of a 'risk' step.",
        "defaults": {
          "dark": "#f8514926",
          "light": "#cf222e1a",
          "highContrast": "#f8514940",
          "highContrastLight": "#cf222e40"
        }
      },
      {
        "id": "agentTour.riskBorder",
        "description": "Left border and badge of a risk step.",
        "defaults": {
          "dark": "#f85149",
          "light": "#cf222e",
          "highContrast": "#f85149",
          "highContrastLight": "#cf222e"
        }
      },
      {
        "id": "agentTour.decisionBackground",
        "description": "Background of a 'decision' step.",
        "defaults": {
          "dark": "#d2992226",
          "light": "#9a67001a",
          "highContrast": "#d2992240",
          "highContrastLight": "#9a670040"
        }
      },
      {
        "id": "agentTour.decisionBorder",
        "description": "Left border and badge of a decision step (needs the reviewer’s judgement).",
        "defaults": {
          "dark": "#d29922",
          "light": "#9a6700",
          "highContrast": "#d29922",
          "highContrastLight": "#9a6700"
        }
      },
      {
        "id": "agentTour.dimWash",
        "description": "Background wash over code outside the step when dimMode is 'wash'.",
        "defaults": {
          "dark": "#00000059",
          "light": "#ffffff8c",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "agentTour.staleBorder",
        "description": "Dashed outline of a step whose anchor was not found.",
        "defaults": {
          "dark": "#db6d28",
          "light": "#bc4c00",
          "highContrast": "#db6d28",
          "highContrastLight": "#bc4c00"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentTour.next",
          "when": "agentTour.active"
        },
        {
          "command": "agentTour.previous",
          "when": "agentTour.active"
        },
        {
          "command": "agentTour.showCard",
          "when": "agentTour.active"
        },
        {
          "command": "agentTour.stop",
          "when": "agentTour.active"
        },
        {
          "command": "agentTour.goto",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentTour.stop",
          "when": "view == agentTour.tours && agentTour.active",
          "group": "navigation@1"
        },
        {
          "command": "agentTour.reload",
          "when": "view == agentTour.tours",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agentTour.start",
          "when": "view == agentTour.tours && viewItem == agentTour.tour",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "agentTour.previous",
          "group": "navigation@1",
          "when": "commentController == agentTour"
        },
        {
          "command": "agentTour.next",
          "group": "navigation@2",
          "when": "commentController == agentTour"
        },
        {
          "command": "agentTour.stop",
          "group": "navigation@3",
          "when": "commentController == agentTour"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/agent-tours-*/*.json",
          "**/agent-tours-*/drafts/*.json"
        ],
        "url": "./schema/tour.schema.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "agentTour.tours",
          "name": "Agent Tours"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentTour.tours",
        "contents": "No tour for this workspace yet. After a multi-file change, the code-tour skill publishes one and it appears here. Tours are kept in a temp folder, never in your repository.\n[Reload Tours](command:agentTour.reload)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/build-skill.mjs",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "package": "vsce package --allow-missing-repository --skip-license --out agent-tour.vsix",
    "vscode:prepublish": "npm run compile",
    "build:skill": "node scripts/build-skill.mjs",
    "test:skill": "npm run compile && node --test skill-src/validate-tour.test.mjs",
    "check:skill": "node scripts/build-skill.mjs && git diff --exit-code --stat -- ../skill/code-tour/scripts ../skill/code-tour/schema",
    "sample-tour": "node ../skill/code-tour/scripts/validate-tour.mjs test/fixtures/tours/2026-09-25-rate-limiting.json --root test/fixtures/sample-workspace --publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
